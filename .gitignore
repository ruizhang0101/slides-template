# Build artifacts
build/
*.pdf
# ...except the template's own demo output, which the README links to.
# (gitignore has no trailing comments: a comment here would become part
# of the pattern.)
!main.pdf

# Commercial fonts must never be committed. theme.sty picks these up
# automatically when present, and falls back when they are not.
fonts/*.otf
fonts/*.ttf

.DS_Store
